# Testnet-only private keys. Never commit a populated .env file.
USER_PRIVATE_KEY=
SPONSOR_PRIVATE_KEY=

# A valid testnet STX address which receives the PoC transfer.
RECIPIENT_ADDRESS=

# 1 microSTX is enough to exercise the two-party transaction format, but the
# origin account must own it. The sponsor pays SPONSOR_FEE_MICROSTX.
TRANSFER_AMOUNT_MICROSTX=1
SPONSOR_FEE_MICROSTX=1000

# Operator refuses new sponsorships if this reserve would be depleted.
OPERATOR_MINIMUM_BALANCE_MICROSTX=10000
# Day 4 HTTP relay policy and local listening port.
OPERATOR_MAXIMUM_FEE_MICROSTX=100000
OPERATOR_HOST=127.0.0.1
OPERATOR_PORT=3002
# Comma-separated browser origins allowed to call relay endpoints in dev.
OSSR_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.18.82:3000
# Base URL used by the origin-side CLI to reach the local relay.
OSSR_API_URL=http://127.0.0.1:3002
# Default public testnet relay for the UI. Copy this browser configuration block
# to ossr-ui/.env.local; Next.js does not load the root .env.local.
# These public values pin the trusted relay. For a different operator, update
# its identity, key, policy, sponsor and contracts together with the proxy URL.
NEXT_PUBLIC_OSSR_RELAY_URL=/relay
OSSR_RELAY_PROXY_URL=https://relay.ossr.network
NEXT_PUBLIC_OSSR_RELAY_ID=relay-ossr-network
NEXT_PUBLIC_OSSR_QUOTE_PUBLIC_KEY=0x049c81f77d8297ad7bbed5d9552eb686e659510e215f1908b8d31468b29c8599ce31cb5d2e46b8889f5f3e1864068addfd6cdce679c3f8cc84a3e6dddf8c34bbda
NEXT_PUBLIC_OSSR_QUOTE_KEY_ID=dev-quote-key
NEXT_PUBLIC_OSSR_POLICY_VERSION=dev
NEXT_PUBLIC_OSSR_SPONSOR_PRINCIPAL=ST1FGRD302T8H4QW29QAJ9N42T3R201S3T97FY551
NEXT_PUBLIC_OSSR_ADAPTER_CONTRACT=ST2SY3PZHMVQMYN1W4SBJ9MPHW4P8J01ST7TVQ68X.sbtc-sponsored-transfer-v1
NEXT_PUBLIC_OSSR_SBTC_CONTRACT=SN3VMHXEN64ZZF71JQ5VESXDWTR301XTTXGF4J8F1.sbtc-token
# Browser pricing refresh interval. Values below 5 seconds fall back to 30.
NEXT_PUBLIC_OSSR_QUOTE_REFRESH_SECONDS=30

# Atomic sBTC adapter (deploy `contracts/sbtc-sponsored-transfer-v1.clar` first).
ADAPTER_CONTRACT_ADDRESS=ST2SY3PZHMVQMYN1W4SBJ9MPHW4P8J01ST7TVQ68X
ADAPTER_CONTRACT_NAME=sbtc-sponsored-transfer-v1
SBTC_CONTRACT_ADDRESS=SN3VMHXEN64ZZF71JQ5VESXDWTR301XTTXGF4J8F1
SBTC_CONTRACT_NAME=sbtc-token
SBTC_TRANSFER_AMOUNT_SATS=100
# Optional fixed-fee override. By default, quotes use the integer-only curve
# 2 * ceil(log2(1 + ceil(amount_sats / 100))).
# SBTC_SPONSOR_FEE_SATS=10
SBTC_LOG_SCALE_SATS=100
SBTC_LOG_GROWTH_SATS=2
# Estimated all-in operator cost in sats. Every quote is at least this amount,
# so set it from recent miner fees, conversion price, infrastructure, and risk.
# Dynamic pricing is fail-closed and supersedes the static break-even fallback.
SBTC_DYNAMIC_PRICING=true
# Conservative allowance above the observed 476-byte transaction.
SBTC_ESTIMATED_TRANSACTION_BYTES=600
SBTC_INFRASTRUCTURE_COST_SATS=0
SBTC_RISK_RESERVE_SATS=0
SBTC_MINIMUM_PROFIT_SATS=1
SBTC_PRICING_CACHE_SECONDS=60
# SBTC_PRICING_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=blockstack,bitcoin&vs_currencies=usd
SBTC_BREAK_EVEN_FEE_SATS=1
SBTC_MAX_SPONSOR_FEE_SATS=10
QUOTE_TTL_BLOCKS=10
# Quote signing uses a separate testnet-only private key from the sponsor key.
QUOTE_PRIVATE_KEY=
QUOTE_KEY_ID=dev-quote-key
RELAY_ID=local-dev-relay
OSSR_POLICY_VERSION=dev
# Optional hex-encoded memo, up to 34 bytes.
SBTC_MEMO_HEX=

# Optional overrides. The defaults target Hiro's public testnet API.
STACKS_API_URL=https://api.testnet.hiro.so
# Stacks Core 4.0.3+ RPC with POST /v3/transactions/simulate enabled.
# The public indexer URL above may not expose this authenticated endpoint.
STACKS_SIMULATION_API_URL=http://127.0.0.1:20443
STACKS_SIMULATION_AUTH_TOKEN=
STACKS_SIMULATION_TIMEOUT_MS=15000
QUOTE_STORE_PATH=.ossr/quotes.json
NONCE_STORE_PATH=.ossr/nonces.json
CONFIRMATION_TIMEOUT_SECONDS=900
POLL_INTERVAL_SECONDS=10

# Project social identity (optional; root .env.local only).
# NOSTR_NSEC is a private signing key. Never use a NEXT_PUBLIC_ prefix.
NOSTR_NPUB=
NOSTR_NSEC=

# Testnet sBTC faucet (server only, in ossr-ui/.env.local). Falls back to SPONSOR_PRIVATE_KEY.
SBTC_FAUCET_PRIVATE_KEY=
# Durable directory required; use a persistent volume when hosting.
# SBTC_FAUCET_DATA_DIR=/var/lib/ossr/sbtc-faucet
# SBTC_FAUCET_CONTRACT=SN3VMHXEN64ZZF71JQ5VESXDWTR301XTTXGF4J8F1.sbtc-token
