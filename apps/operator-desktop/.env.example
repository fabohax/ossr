# OSSR Operator Desktop example config
# Copy this to .env.local (or use the values directly in the local setup)

# Relay URL exposed by the local OSSR operator service.
OSSR_RELAY_URL=http://127.0.0.1:3002

# Stacks follower endpoint used for sync and health checks.
STACKS_FOLLOWER_URL=http://127.0.0.1:20443

# Public reference endpoint for comparison to the testnet chain tip.
STACKS_REFERENCE_URL=https://api.testnet.hiro.so
