# OSSR Operator CLI example environment
# Copy to .env.local or .env before running the CLI or relay.

# Required sponsor wallet key for the operator.
SPONSOR_PRIVATE_KEY=__REPLACE_WITH_TESTNET_SPONSOR_PRIVATE_KEY__

# Public Stacks API used to read chain state and broadcast transactions.
STACKS_API_URL=https://api.testnet.hiro.so

# Optional: minimum balance threshold before the operator is considered healthy.
OPERATOR_MINIMUM_BALANCE_MICROSTX=0

# Optional: local durable nonce store path.
NONCE_STORE_PATH=.ossr/nonces.json

# Optional: local quote persistence path.
QUOTE_STORE_PATH=.ossr/quotes.json

# Optional: local reimbursement persistence path.
REIMBURSEMENT_STORE_PATH=.ossr/reimbursements.json

# Optional: local operator registry store path.
OPERATOR_REGISTRY_PATH=.ossr/operators.json

# Optional: relay bind and port.
OPERATOR_HOST=127.0.0.1
OPERATOR_PORT=3002

# Optional: quote signing key; must be distinct from the sponsor key.
QUOTE_PRIVATE_KEY=

# Optional: simulation API used to validate transactions before broadcast.
STACKS_SIMULATION_API_URL=
STACKS_SIMULATION_AUTH_TOKEN=
STACKS_SIMULATION_TIMEOUT_MS=15000

# Optional: reimbursement payer wallet key when using the reimbursement worker.
REIMBURSEMENT_PAYER_PRIVATE_KEY=
REIMBURSEMENT_PAYMENT_FEE_MICROSTX=10000

# Optional: CORS setting for browser-based clients.
OSSR_CORS_ALLOWED_ORIGINS=

# Optional: policy knobs for reimbursements.
REIMBURSEMENT_RATE_NUMERATOR=1
REIMBURSEMENT_RATE_DENOMINATOR=100
REIMBURSEMENT_MARKUP_BPS=500
REIMBURSEMENT_FAILURE_RESERVE_SATS=2
REIMBURSEMENT_MINIMUM_SATS=10
REIMBURSEMENT_MAXIMUM_SATS=1000
CONFIRMATION_TIMEOUT_SECONDS=86400

# Optional: registry and health settings.
OPERATOR_HEARTBEAT_TIMEOUT_MS=60000
OPERATOR_MAXIMUM_FAILURE_RATE=0.5

# Optional: sBTC adapter / contract settings.
ADAPTER_CONTRACT_ADDRESS=
ADAPTER_CONTRACT_NAME=
SBTC_CONTRACT_ADDRESS=
SBTC_CONTRACT_NAME=
USDCX_ADAPTER_CONTRACT_ADDRESS=
USDCX_CONTRACT_ADDRESS=
USDCX_CONTRACT_NAME=

# Optional: quote pricing and sponsor fee configuration.
SBTC_SPONSOR_FEE_SATS=
SBTC_BREAK_EVEN_FEE_SATS=1
SBTC_DYNAMIC_PRICING=false
SBTC_ESTIMATED_TRANSACTION_BYTES=600
SBTC_INFRASTRUCTURE_COST_SATS=0
SBTC_RISK_RESERVE_SATS=0
SBTC_MINIMUM_PROFIT_SATS=1
SBTC_PRICING_API_URL=
SBTC_PRICING_CACHE_SECONDS=60
SBTC_LOG_SCALE_SATS=100
SBTC_LOG_GROWTH_SATS=2

# Optional: beta access / budget features.
OSSR_BETA_ACCOUNTING_TOKEN=
OSSR_PAUSE_FILE=.ossr/paused

# Optional: relay identifiers and policy metadata.
OPERATOR_ID=
RELAY_ID=
OSSR_POLICY_VERSION=
QUOTE_KEY_ID=
